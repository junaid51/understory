{
  "name": "understory-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "bench",
    "demo"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "bench": "NODE_OPTIONS='--expose-gc --max-old-space-size=8192' vite-node bench/src/run.ts",
    "bench:calibrate": "NODE_OPTIONS='--expose-gc --max-old-space-size=8192' vite-node bench/src/calibrate.ts",
    "bench:calibrate:report": "vite-node bench/src/calibration-report.ts",
    "bench:m1": "NODE_OPTIONS='--expose-gc --max-old-space-size=8192' vite-node bench/src/m1/run.ts",
    "bench:m1:verdict": "vite-node bench/src/m1/verdict.ts",
    "bench:report": "vite-node bench/src/report.ts",
    "bench:verdict": "vite-node bench/src/verdict.ts",
    "demo": "npm run dev --workspace @understory/demo",
    "demo:build": "npm run build --workspace @understory/demo",
    "format": "prettier --check .",
    "lint": "eslint .",
    "test": "vitest run",
    "test:deep": "UNDERSTORY_DEEP=1 vitest run",
    "typecheck": "tsc --build --force",
    "verify": "bash scripts/verify.sh"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "fast-check": "^3.23.2",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vite-node": "^6.0.0",
    "vitest": "^5.0.0"
  }
}
